[Unit]
Description=VitalMesh agent graph (all roles in one process)
After=vitalmesh-infra.service
Requires=vitalmesh-infra.service

[Service]
User=vmadmin
WorkingDirectory=/opt/vitalmesh/app
EnvironmentFile=/opt/vitalmesh/env
ExecStart=/opt/vitalmesh/app/.venv/bin/python -m vitalmesh_agents triage nutrition movement condition aggregator synthesizer guardian checker release tracker
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
