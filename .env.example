# Copy to .env and fill in. .env is gitignored.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Langfuse Cloud (free Hobby plan): tracing only, no PII (D65)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Google Calendar (D80): create an OAuth client (Web application) in Google Cloud Console; redirect URI
# http://127.0.0.1:8000/v1/integrations/google/callback ; scope calendar.events ; keep it in Testing mode
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Fernet key that encrypts the stored Google refresh token (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
VITALMESH_TOKEN_KEY=
